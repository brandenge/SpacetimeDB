vec_uuid_on_delete :: proc(registry: ^client.Row_Change_Listener_Registry, callback: Vec_Uuid_Delete_Callback, user: rawptr = nil) -> (client.Row_Change_Listener_Id, client.Error) {
	if registry == nil || callback == nil do return 0, .Invalid_Argument
	when ODIN_OS == .JS do context = runtime.default_context()
	state := new(vec_uuid_delete_Listener_State)
