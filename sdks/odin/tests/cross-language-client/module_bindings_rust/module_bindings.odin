Vec_Uuid_Insert_Callback :: proc(row: ^VecUuid, user: rawptr)
vec_uuid_insert_Listener_State :: struct { callback: Vec_Uuid_Insert_Callback, user: rawptr }
vec_uuid_dispatch_on_insert :: proc(change: client.Row_Change, user: rawptr) {
	state := cast(^vec_uuid_insert_Listener_State)user
	row, consumed, err := host.decode_row_from(VecUuid, change.row)
	if err != .None || consumed != len(change.row) {
		host.delete_decoded_row(VecUuid, &row)
		return
	}
	defer host.delete_decoded_row(VecUuid, &row)
	state.callback(&row, state.user)
}

vec_uuid_destroy_on_insert :: proc(user: rawptr) { free(cast(^vec_uuid_insert_Listener_State)user) }

vec_uuid_on_insert :: proc(registry: ^client.Row_Change_Listener_Registry, callback: Vec_Uuid_Insert_Callback, user: rawptr = nil) -> (client.Row_Change_Listener_Id, client.Error) {
	if registry == nil || callback == nil do return 0, .Invalid_Argument
	when ODIN_OS == .JS do context = runtime.default_context()
	state := new(vec_uuid_insert_Listener_State)
	state^ = vec_uuid_insert_Listener_State{callback = callback, user = user}
	id, err := client.row_change_event_listener_add(registry, "vec_uuid", .Insert, vec_uuid_dispatch_on_insert, state, vec_uuid_destroy_on_insert)
	if err != .None do free(state)
	return id, err
}

vec_uuid_remove_on_insert :: proc(registry: ^client.Row_Change_Listener_Registry, id: client.Row_Change_Listener_Id) -> bool {
	return client.row_change_listener_remove(registry, id)
}

Vec_Uuid_Delete_Callback :: proc(row: ^VecUuid, user: rawptr)
