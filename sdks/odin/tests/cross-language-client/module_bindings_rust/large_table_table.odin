large_table_where_p_gt :: proc(query: ^client.Sql_Query_Builder, value: string) -> client.Sql_Query_Error {
	return client.sql_query_where(string, query, "p", .Greater, value)
}

large_table_where_p_ge :: proc(query: ^client.Sql_Query_Builder, value: string) -> client.Sql_Query_Error {
	return client.sql_query_where(string, query, "p", .Greater_Or_Equal, value)
}

large_table_dispatch :: proc(changes: []client.Row_Change, handlers: Large_Table_Handlers, user: rawptr = nil) {
	client.dispatch_changes(changes, LARGE_TABLE_TABLE, handlers, user)
}
