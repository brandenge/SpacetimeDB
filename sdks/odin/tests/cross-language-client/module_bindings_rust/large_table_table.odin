	extract_key := proc(encoded_row: []u8, user: rawptr) -> ([]u8, host.Codec_Error) {
		_ = user
		decoded, consumed, decode_err := host.decode_row_from(LargeTable, encoded_row)
		if decode_err != .None do return nil, decode_err
		if consumed != len(encoded_row) {
			host.delete_decoded_row(LargeTable, &decoded)
			return nil, .Trailing_Bytes
		}
		key_bytes, encode_err := client.encode_value(host.I256, decoded.l)
		host.delete_decoded_row(LargeTable, &decoded)
		return key_bytes, encode_err
	}
	index_err := client.cache_index_register(cache, "large_table.l", LARGE_TABLE_TABLE, extract_key)
	if index_err != .None do return nil, index_err
	key_bytes, encode_err := client.encode_value(host.I256, value)
