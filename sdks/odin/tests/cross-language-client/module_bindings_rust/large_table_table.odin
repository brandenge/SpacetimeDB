large_table_l_less_value :: proc(left, right: host.I256) -> bool {
	left_bytes := transmute([32]u8)left
	right_bytes := transmute([32]u8)right
	left_negative := left_bytes[31] & 0x80 != 0
	right_negative := right_bytes[31] & 0x80 != 0
	if left_negative != right_negative do return left_negative
	for offset in 0 ..< 32 {
		index := 31 - offset
		if left_bytes[index] != right_bytes[index] do return left_bytes[index] < right_bytes[index]
	}
	return false
}

