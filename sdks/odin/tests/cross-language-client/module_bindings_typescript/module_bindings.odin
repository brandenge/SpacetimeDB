Row_Change_Dispatcher :: struct {
	tables: Table_Callbacks,
	user: rawptr,
}

// Use as Connect_Options.on_row_changes with a stable Row_Change_Dispatcher user pointer.
dispatch_connection_row_changes :: proc(changes: []client.Row_Change, user: rawptr) {
	dispatcher := cast(^Row_Change_Dispatcher)user
	dispatch_all(changes, dispatcher.tables, dispatcher.user)
}

register_row_change_dispatcher :: proc(registry: ^client.Row_Change_Listener_Registry, dispatcher: ^Row_Change_Dispatcher) -> (client.Row_Change_Listener_Id, client.Error) {
	return client.row_change_listener_add(registry, dispatch_connection_row_changes, dispatcher)
}

unregister_row_change_dispatcher :: proc(registry: ^client.Row_Change_Listener_Registry, id: client.Row_Change_Listener_Id) -> bool {
	return client.row_change_listener_remove(registry, id)
}
